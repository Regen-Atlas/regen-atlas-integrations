# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Atlantis (Impact Certificates)
ATLANTIS_PROTOCOL_ID=uuid-of-atlantis-protocol

# Silvi (REST API - regenerative projects)
SILVI_PROTOCOL_ID=uuid-of-silvi-protocol
SILVI_API_URL=https://your-silvi-api-url/projects

# RPC overrides (recommended for production - public RPCs have strict rate limits)
# Get free API keys: Alchemy (alchemy.com), Infura (infura.io)
# RPC_BASE_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_ARBITRUM_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_CELO_URL=https://celo-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_OPTIMISM_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional: Throttle between RPC calls (ms). Default 150. Increase if still rate limited.
# RPC_THROTTLE_MS=200

# Optional: Max retries on rate limit. Default 5.
# RPC_MAX_RETRIES=5
